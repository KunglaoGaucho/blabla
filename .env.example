# Copie para .env e preencha. O .env não vai para o GitHub.
MONGODB_URI=mongodb+srv://USUARIO:SENHA@CLUSTER.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=thindesk

# Login do sistema (opcional)
THINDESK_ADMIN_USUARIO=admin
THINDESK_ADMIN_SENHA=thindesk

# Gera chamados de exemplo na primeira execução (true/false)
THINDESK_DADOS_EXEMPLO=true
